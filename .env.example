# Local development. Copy to .env in the repository root.
APP_NAME=Moscow Tram Forecast API
APP_VERSION=0.2.0
APP_ENV=development
LOG_LEVEL=INFO
CATALOG_BACKEND=memory
PREDICTOR_FACTORY=app.predictors.mock:build_predictor
# Optional local model adapter; paths relative to repository root.
# PREDICTOR_FACTORY=app.predictors.artifact:build_predictor
# MODEL_PATH=models/example.cbm
# MODEL_METADATA_PATH=models/example.metadata.json
POSTGRES_DB=transport
POSTGRES_USER=transport
POSTGRES_PASSWORD=transport_local_only
DB_HOST=127.0.0.1
DB_PORT=55432
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
# Dispatcher login. Outside development/test AUTH_SECRET_KEY is required;
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_ENABLED=true
AUTH_SECRET_KEY=
AUTH_USERS_FILE=mock_data/dispatchers.json
AUTH_TOKEN_TTL_SECONDS=43200
# Frontend signs the dispatcher out after this many minutes without activity.
VITE_IDLE_TIMEOUT_MINUTES=120
# Used by Vite's server-side proxy, never sent to the browser.
BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Optional browser map key; set locally or in deployment build settings, never commit a real key.
VITE_YANDEX_MAPS_API_KEY=
