  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "ForecastPoint": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "predicted_load": {
            "type": "number",
            "minimum": 0.0,
            "title": "Predicted Load"
          },
          "lower_bound": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower Bound"
          },
          "upper_bound": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Bound"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "predicted_load"
        ],
        "title": "ForecastPoint"
      },
      "ForecastResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1.0",
            "title": "Contract Version",
            "default": "1.0"
          },
          "series_key": {
            "$ref": "#/components/schemas/SeriesKey"
          },
          "horizon": {
            "$ref": "#/components/schemas/Horizon"
          },
          "resolution": {
            "type": "string",
            "enum": [
              "PT1H",
              "P1D",
              "P1M"
            ],
            "title": "Resolution"
          },
          "forecast_origin": {
            "type": "string",
            "format": "date-time",
            "title": "Forecast Origin"
          },
          "value_unit": {
            "type": "string",
            "minLength": 1,
            "title": "Value Unit"
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "demo_mean",
              "sum",
              "mean",
              "max",
              "last"
            ],
            "title": "Aggregation"
          },
          "is_mock": {
            "type": "boolean",
            "title": "Is Mock"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "title": "Model Version"
          },
          "interval_level": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 1.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Level"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            },
            "type": "array",
            "maxItems": 744,
            "minItems": 1,
            "title": "Points"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "series_key",
          "horizon",
          "resolution",
          "forecast_origin",
          "value_unit",
          "aggregation",
          "is_mock",
          "model_version",
          "points"
        ],
        "title": "ForecastResponse"
      },
      "Horizon": {
        "type": "string",
        "enum": [
          "day",
          "month",
          "year"
        ],
        "title": "Horizon"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "service",
          "version",
          "environment"
        ],
        "title": "LivenessResponse"
      },
      "MapForecastPoint": {
        "properties": {
          "route_id": {
            "type": "string",
            "title": "Route Id"
          },
          "route_name": {
            "type": "string",
            "title": "Route Name"
          },
          "route_color": {
            "type": "string",
            "title": "Route Color"
          },
          "stop_id": {
            "type": "string",
            "title": "Stop Id"
          },
          "stop_name": {
            "type": "string",
            "title": "Stop Name"
          },
          "direction_id": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Direction Id"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sequence"
          },
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "predicted_load": {
            "type": "number",
            "minimum": 0.0,
            "title": "Predicted Load"
          },
          "lower_bound": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower Bound"
          },
          "upper_bound": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Bound"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "route_id",
          "route_name",
          "route_color",
          "stop_id",
          "stop_name",
          "direction_id",
          "sequence",
          "lat",
          "lon",
          "predicted_load"
        ],
        "title": "MapForecastPoint"
      },
      "MapForecastResponse": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "1.0",
            "title": "Contract Version",
            "default": "1.0"
          },
          "horizon": {
            "$ref": "#/components/schemas/Horizon"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
